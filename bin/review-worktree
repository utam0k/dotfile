#!/usr/bin/env bash
# Print the review worktree of a GitHub pull request, made by gh-worktree in
# review mode: the files are the PR's latest head and HEAD is the merge base
# with its base branch, so the PR's changes show as local changes.
#
#   review-worktree <number>
#
# A missing worktree is created. An existing one is moved to the PR's latest
# head, which gh-worktree refuses while it has local edits. Shared by the zsh
# `review` command and Neovim's :Review.
set -euo pipefail

number=${1-}
number=${number#\#}
if [[ $# -ne 1 || ! $number =~ ^[0-9]+$ ]]; then
    echo "usage: review-worktree <pull request number>" >&2
    exit 2
fi

# Neovim shows stderr as the error, so report progress only to a terminal.
[[ -t 2 ]] && echo "preparing #$number" >&2

if gh worktree cd "$number" >/dev/null 2>&1; then
    # --reuse turns review mode on if the worktree was made without it but
    # leaves it at its commit; sync moves it to the latest head.
    path=$(gh worktree pr --reuse --cd "$number")
    gh worktree sync "$number" >&2
else
    path=$(gh worktree pr --cd "$number")
fi
printf '%s\n' "$path"
