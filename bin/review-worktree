#!/usr/bin/env bash
# Check out a GitHub pull request into <repo>/.worktree/pr/pr-<number>.
#
#   review-worktree <number>   prints the worktree path and the base ref to
#                              diff against with a merge base, one per line
#   review-worktree --repo     prints the host/owner/name gh is given
#
# The layout matches gh-worktree, so existing worktrees are reused and moved to
# the PR's latest head. A worktree with uncommitted changes to tracked files is
# never touched. Shared by the zsh `review` command and Neovim's :Review.
set -euo pipefail

die() {
    echo "review-worktree: $*" >&2
    exit 1
}

# host/owner/name from an https, ssh or scp-like remote URL.
repo_of() {
    local url=$1 host path
    local scheme='^[A-Za-z][A-Za-z0-9+.-]*://([^/]+)/(.+)$'
    local scp='^([^/:]*@)?([^/:@]+):(.+)$'
    if [[ $url =~ $scheme ]]; then
        host=${BASH_REMATCH[1]##*@}
        host=${host%:*}
        path=${BASH_REMATCH[2]}
    elif [[ $url =~ $scp ]]; then
        host=${BASH_REMATCH[2]}
        path=${BASH_REMATCH[3]}
    else
        return 1
    fi
    path=${path%/}
    echo "$host/${path%.git}"
}

[[ $# -eq 1 ]] || die "usage: review-worktree <pull request number> | --repo"

# The first entry is the main worktree, also when run from a PR worktree.
main=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
# Fork checkouts track the PR's repository as upstream.
remotes=$(git -C "$main" remote)
if grep -qx upstream <<<"$remotes"; then
    remote=upstream
elif grep -qx origin <<<"$remotes"; then
    remote=origin
else
    die "no upstream or origin remote in $main"
fi
url=$(git -C "$main" config --get "remote.$remote.url")
repo=$(repo_of "$url") || die "cannot parse remote URL: $url"
if [[ $1 == --repo ]]; then
    echo "$repo"
    exit
fi

number=${1#\#}
[[ $number =~ ^[0-9]+$ ]] || die "not a pull request number: $1"

# gh needs --repo: with several remotes and no default it fails non-interactively.
info=$(gh pr view "$number" --repo "$repo" --json baseRefName,title --jq '.baseRefName + "\t" + .title')
base=${info%%$'\t'*}
if [[ -t 2 ]]; then
    echo "fetching #$number ${info#*$'\t'}" >&2
fi
git -C "$main" fetch --quiet "$remote" "refs/pull/$number/head" "refs/heads/$base"
head=$(git -C "$main" rev-parse FETCH_HEAD)

path=$main/.worktree/pr/pr-$number
if [[ -e $path ]]; then
    # A plain directory here would make git act on the main worktree.
    top=$(git -C "$path" rev-parse --show-toplevel)
    [[ $top -ef $path ]] || die "$path exists but is not a git worktree"
    if [[ -n $(git -C "$path" status --porcelain --untracked-files=no) ]]; then
        die "$path has uncommitted changes; commit or discard them first"
    fi
    git -C "$path" checkout --quiet --detach "$head"
else
    git -C "$main" worktree add --quiet --detach "$path" "$head"
fi
printf '%s\n%s\n' "$path" "$remote/$base"
